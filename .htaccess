# Hide version control, dotfiles and dev tooling from the public web.
# Deploying the repo into public_html also copies .git/ and tools/.
<IfModule mod_alias.c>
  RedirectMatch 404 /\.(?!well-known/)
  RedirectMatch 404 ^/tools(/|$)
</IfModule>

# Página de error propia en lugar de la genérica del hosting
ErrorDocument 404 /404.html

# Canonical host: send www.benamar.es to benamar.es
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.benamar\.es$ [NC]
  RewriteRule ^(.*)$ https://benamar.es/$1 [R=301,L]
</IfModule>

# HTML: never cache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType application/json "access plus 1 hours"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|mjs|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType font/woff2 .woff2
  AddType image/x-icon .ico
</IfModule>

# Compresión del texto. Las imágenes y las tipografías woff2 ya vienen
# comprimidas y volver a comprimirlas solo gasta procesador.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>
